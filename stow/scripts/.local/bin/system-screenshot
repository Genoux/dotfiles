#!/bin/bash

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
FILENAME="$OUTPUT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

mkdir -p "$OUTPUT_DIR"

# Default is to capture and be done with it: the file lands, the clipboard gets
# it, and the shell is told so it can offer copy/edit/discard. --edit keeps the
# old behaviour of opening the annotation editor before anything is saved.
EDIT=false

# Announce the capture to the shell. Best-effort on purpose: quickshell may be
# dead or restarting, and that must not fail a capture or print noise.
announce() {
  quickshell ipc call capture saved "$1" >/dev/null 2>&1 || true
}

# Shell first, clipboard second: the card is what you are waiting to see, and
# wl-copy's fork costs frames you would spend staring at nothing.
finish() {
  announce "$FILENAME"
  wl-copy --type image/png <"$FILENAME" 2>/dev/null || true
}

# grim writes the file itself, then the shell and the clipboard are updated.
# With --edit the pixels go to satty instead and it owns the save.
capture() {
  if $EDIT; then
    grim "$@" - | satty --filename - --output-filename "$FILENAME"
    return
  fi

  grim "$@" "$FILENAME" || return 1
  finish
}

# Trim geometry to ensure it fits within monitor bounds
trim_geometry() {
    local geometry="${1}"
    local xy_str=$(echo "${geometry}" | cut -d' ' -f1)
    local wh_str=$(echo "${geometry}" | cut -d' ' -f2)
    local x=$(echo "${xy_str}" | cut -d',' -f1)
    local y=$(echo "${xy_str}" | cut -d',' -f2)
    local width=$(echo "${wh_str}" | cut -dx -f1)
    local height=$(echo "${wh_str}" | cut -dx -f2)

    # Get monitor bounds (accounting for rotation/transform)
    local max_width=$(hyprctl monitors -j | jq -r '[.[] | if (.transform % 2 == 0) then (.x + .width) else (.x + .height) end] | max')
    local max_height=$(hyprctl monitors -j | jq -r '[.[] | if (.transform % 2 == 0) then (.y + .height) else (.y + .width) end] | max')
    local min_x=$(hyprctl monitors -j | jq -r '[.[] | (.x)] | min')
    local min_y=$(hyprctl monitors -j | jq -r '[.[] | (.y)] | min')

    local cropped_x=$x
    local cropped_y=$y
    local cropped_width=$width
    local cropped_height=$height

    # Crop if window extends beyond right/bottom edges
    if ((x + width > max_width)); then
        cropped_width=$((max_width - x))
    fi
    if ((y + height > max_height)); then
        cropped_height=$((max_height - y))
    fi

    # Adjust if window extends beyond left/top edges
    if ((x < min_x)); then
        cropped_x=$min_x
        cropped_width=$((cropped_width + x - min_x))
    fi
    if ((y < min_y)); then
        cropped_y=$min_y
        cropped_height=$((cropped_height + y - min_y))
    fi

    # Ensure dimensions are positive
    if ((cropped_width <= 0 || cropped_height <= 0)); then
        return 1
    fi

    printf "%s,%s %sx%s" "${cropped_x}" "${cropped_y}" "${cropped_width}" "${cropped_height}"
}

MODE="region"

for arg in "$@"; do
  case "$arg" in
    output | window | region)
      MODE="$arg"
      ;;
    --edit)
      EDIT=true
      ;;
  esac
done


case "$MODE" in
    window)
        # Point at the window you mean rather than inferring it. Focus cannot
        # answer this: with focus-follows-mouse, reaching for the capture
        # popover already changed which window is active, and a layer surface
        # holding focus empties `hyprctl activewindow` outright. slurp -r snaps
        # the selection to the boxes it is handed, so hovering highlights a
        # whole window and one click takes it.
        #
        # Visible workspaces only — a window you cannot see is not one you are
        # pointing at. Layer surfaces never appear in `clients`, so the shell's
        # own panels are not offered as targets.
        boxes=$(hyprctl clients -j \
            | jq -r --argjson ws "$(hyprctl monitors -j | jq -c '[.[].activeWorkspace.id]')" \
                '.[] | select(.mapped and (.hidden | not)
                              and (.workspace.id as $w | $ws | index($w) != null))
                 | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')

        if [[ -z "$boxes" ]]; then
            notify-send "Screenshot failed" "No window to capture" -u critical -t 3000
            exit 1
        fi

        geometry=$(printf '%s\n' "$boxes" | slurp -r) || exit 1
        [[ -n "$geometry" ]] || exit 1

        # Let slurp's overlay leave the screen before grim reads it. Long
        # enough for the compositor to drop the layer surface, short enough not
        # to be felt: grim itself already costs ~200ms on a full output.
        sleep 0.15

        trimmed_geometry=$(trim_geometry "$geometry")
        if [[ -n "$trimmed_geometry" ]]; then
            capture -g "$trimmed_geometry"
        else
            notify-send "Screenshot failed" "Window is off screen" -u critical -t 3000
            exit 1
        fi
        ;;

    region)
        geometry=$(slurp)

        if [[ -n "$geometry" ]]; then
            sleep 0.15
            capture -g "$geometry"
        else
            exit 1
        fi
        ;;

    output)
        # Get focused monitor geometry
        monitor=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true)')
        x=$(echo "$monitor" | jq -r '.x')
        y=$(echo "$monitor" | jq -r '.y')
        w=$(echo "$monitor" | jq -r '.width')
        h=$(echo "$monitor" | jq -r '.height')

        capture -g "${x},${y} ${w}x${h}"
        ;;
esac
