#!/usr/bin/env bash
# Control the local 9router AI gateway (Docker container behind a user service).
set -euo pipefail

IMAGE="decolua/9router:latest"
SERVICE="9router.service"
DASHBOARD="http://localhost:20128"
ENV_FILE="$HOME/.config/9router/env"

die() {
    echo "system-9router: $1" >&2
    exit 1
}

require_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker info >/dev/null 2>&1 || die "cannot reach the docker daemon (is docker.service running?)"
}

cmd_status() {
    systemctl --user status "$SERVICE" --no-pager || true
    echo
    if curl -sf -o /dev/null --max-time 3 "$DASHBOARD"; then
        echo "gateway:  responding at $DASHBOARD"
    else
        echo "gateway:  not responding at $DASHBOARD"
    fi
    if [[ -f "$ENV_FILE" ]] && grep -q '^[[:space:]]*export' "$ENV_FILE"; then
        echo "clients:  $ENV_FILE is active"
    else
        echo "clients:  $ENV_FILE has no active exports (CLIs bypass the gateway)"
    fi
}

cmd_update() {
    require_docker
    docker pull "$IMAGE"
    systemctl --user restart "$SERVICE"
    echo "system-9router: updated and restarted"
}

case "${1:-status}" in
    status) cmd_status ;;
    start) systemctl --user start "$SERVICE" ;;
    stop) systemctl --user stop "$SERVICE" ;;
    restart) systemctl --user restart "$SERVICE" ;;
    enable) systemctl --user enable --now "$SERVICE" ;;
    disable) systemctl --user disable --now "$SERVICE" ;;
    logs) journalctl --user -u "$SERVICE" -f ;;
    update) cmd_update ;;
    dashboard) xdg-open "$DASHBOARD" >/dev/null 2>&1 & ;;
    help | -h | --help)
        cat <<EOF
Usage: system-9router [command]

  status      Service state, gateway reachability, client wiring (default)
  start       Start the gateway
  stop        Stop the gateway
  restart     Restart the gateway
  enable      Enable at login and start now
  disable     Disable at login and stop now
  logs        Follow the container log
  update      Pull the latest image and restart
  dashboard   Open $DASHBOARD
EOF
        ;;
    *) die "unknown command: $1 (try 'system-9router help')" ;;
esac
