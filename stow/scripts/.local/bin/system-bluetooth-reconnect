#!/usr/bin/env bash
# Reconnect trusted Bluetooth devices after login or resume.
# Audio: restore the sink that was connected before sleep, otherwise the
# first trusted speaker that answers. Never connect two A2DP sinks at once.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles"
STATE_FILE="$STATE_DIR/bluetooth-last-audio"

is_paired_trusted() {
  local info="$1"
  echo "$info" | grep -q "Paired: yes" && echo "$info" | grep -q "Trusted: yes"
}

is_connected() {
  echo "$1" | grep -q "Connected: yes"
}

is_audio_sink() {
  echo "$1" | grep -Eq "Audio Sink|A2DP|Icon: audio-(headset|headphones|card)"
}

is_input_device() {
  echo "$1" | grep -Eq "Human Interface Device|Icon: input-"
}

device_info() {
  bluetoothctl info "$1" 2>/dev/null || true
}

list_device_macs() {
  bluetoothctl devices 2>/dev/null | awk '/^Device / { print $2 }'
}

wait_for_adapter() {
  local _
  bluetoothctl power on >/dev/null 2>&1 || true
  for _ in $(seq 1 40); do
    if bluetoothctl show 2>/dev/null | grep -q "Powered: yes" \
      && bluetoothctl devices >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  echo "bluetooth-reconnect: adapter not ready" >&2
  return 1
}

save_connected_audio() {
  mkdir -p "$STATE_DIR"
  local mac info
  : >"$STATE_FILE"
  for mac in $(list_device_macs); do
    info=$(device_info "$mac")
    if is_paired_trusted "$info" && is_audio_sink "$info" && is_connected "$info"; then
      printf '%s\n' "$mac" >>"$STATE_FILE"
    fi
  done
}

try_connect() {
  local mac="$1"
  local attempt
  for attempt in 1 2 3; do
    if timeout 8 bluetoothctl connect "$mac" >/dev/null 2>&1; then
      return 0
    fi
    sleep 2
  done
  return 1
}

reconnect_inputs() {
  local mac info
  for mac in $(list_device_macs); do
    info=$(device_info "$mac")
    if ! is_paired_trusted "$info" || ! is_input_device "$info"; then
      continue
    fi
    if is_connected "$info"; then
      continue
    fi
    try_connect "$mac" || true
  done
}

preferred_audio_macs() {
  if [[ -f "$STATE_FILE" ]]; then
    grep -E '^[0-9A-Fa-f:]+$' "$STATE_FILE" || true
  fi
}

other_audio_macs() {
  local preferred mac info
  preferred=$(preferred_audio_macs | tr '\n' ' ')
  for mac in $(list_device_macs); do
    case " $preferred " in
      *" $mac "*) continue ;;
    esac
    info=$(device_info "$mac")
    if is_paired_trusted "$info" && is_audio_sink "$info"; then
      printf '%s\n' "$mac"
    fi
  done
}

audio_already_connected() {
  local mac info
  for mac in $(list_device_macs); do
    info=$(device_info "$mac")
    if is_paired_trusted "$info" && is_audio_sink "$info" && is_connected "$info"; then
      return 0
    fi
  done
  return 1
}

reconnect_audio() {
  local mac info
  if audio_already_connected; then
    return 0
  fi

  for mac in $(preferred_audio_macs) $(other_audio_macs); do
    info=$(device_info "$mac")
    if ! is_paired_trusted "$info" || ! is_audio_sink "$info"; then
      continue
    fi
    if is_connected "$info"; then
      return 0
    fi
    if try_connect "$mac"; then
      return 0
    fi
  done
}

reconnect() {
  wait_for_adapter
  # Controller often reports Powered before it will accept connections.
  sleep 2
  reconnect_inputs
  reconnect_audio
}

case "${1:-reconnect}" in
  save) save_connected_audio ;;
  reconnect | "") reconnect ;;
  *)
    echo "usage: system-bluetooth-reconnect [save|reconnect]" >&2
    exit 2
    ;;
esac
