# Matugen-generated ghostty theme — do not edit
# Selected via `theme = matugen` in stow/ghostty/.config/ghostty/config
background = {{colors.surface.default.hex}}
foreground = {{colors.on_surface.default.hex}}
cursor-color = {{colors.primary.default.hex}}
cursor-text = {{colors.on_primary.default.hex}}
selection-background = {{colors.surface_container_high.default.hex}}
selection-foreground = {{colors.on_surface.default.hex}}

# ANSI 0 is printed as text, so it cannot be the background; no Material role sits
# between outline_variant (2:1) and outline (slot 8), hence the derived tone.
palette = 0={{colors.outline.default.hex | set_lightness: 45.0}}
palette = 1={{colors.primary.default.hex}}
palette = 2={{colors.secondary.default.hex}}
palette = 3={{colors.tertiary.default.hex}}
palette = 4={{colors.primary.default.hex}}
palette = 5={{colors.secondary_fixed.default.hex}}
palette = 6={{colors.tertiary_fixed.default.hex}}
palette = 7={{colors.on_surface_variant.default.hex}}
palette = 8={{colors.outline.default.hex}}
palette = 9={{colors.primary.default.hex}}
palette = 10={{colors.secondary.default.hex}}
palette = 11={{colors.tertiary.default.hex}}
palette = 12={{colors.primary.default.hex}}
palette = 13={{colors.secondary_fixed.default.hex}}
palette = 14={{colors.tertiary.default.hex}}
palette = 15={{colors.on_surface.default.hex}}
