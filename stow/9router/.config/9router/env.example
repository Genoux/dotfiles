# Copy to env in this directory to route AI CLIs through the local 9router gateway.
# ~/.config/9router/env is machine-local and never committed; the key below is
# generated per install by the dashboard at http://localhost:20128.
#
# Sourced from .zshrc only when it exists, so an unconfigured machine keeps
# talking to the upstream providers directly.

# export NINEROUTER_API_KEY="paste-from-dashboard"

# Codex and other OpenAI-compatible clients.
# export OPENAI_BASE_URL="http://localhost:20128"
# export OPENAI_API_KEY="$NINEROUTER_API_KEY"

# Claude Code. Unset these to go straight to Anthropic on your own subscription.
# export ANTHROPIC_BASE_URL="http://localhost:20128/v1"
# export ANTHROPIC_AUTH_TOKEN="$NINEROUTER_API_KEY"
