#!/bin/bash
# Desktop launcher wrapper for dotfiles menu with fixed window size

DOTFILES_DIR="$(cd "$(dirname "$(dirname "${BASH_SOURCE[0]}")")" && pwd)"

WINDOW_TITLE="Dotfiles Manager"
WINDOW_CLASS="tui.dotfiles-manager"

# Window size (columns x rows)
WINDOW_COLS=80
WINDOW_ROWS=25

lua_string() {
    jq -Rn --arg value "$1" '$value'
}

# Check if window is already running
if command -v hyprctl &>/dev/null; then
    if hyprctl clients | grep -q "^[[:space:]]*title: $WINDOW_TITLE$"; then
        # Focus the existing window
        hyprctl dispatch "hl.dsp.focus({ window = $(lua_string "title:$WINDOW_TITLE") })"
        exit 0
    fi
fi

exec ghostty \
    --class="$WINDOW_CLASS" \
    --title="$WINDOW_TITLE" \
    --window-width="$WINDOW_COLS" \
    --window-height="$WINDOW_ROWS" \
    -e "$DOTFILES_DIR/dotfiles" menu
