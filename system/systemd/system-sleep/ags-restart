#!/bin/bash
# Restart AGS after suspend/hibernate resume
# Ensures AGS is running after Wake-on-LAN

if [ "$1" = "post" ]; then
    # Get the user running Hyprland
    HYPR_USER=$(ps aux | grep "Hyprland" | grep -v grep | awk '{print $1}' | head -1)

    if [ -n "$HYPR_USER" ]; then
        USER_ID=$(id -u "$HYPR_USER")
        XDG_DIR="/run/user/$USER_ID"

        # Wait for Wayland display to be ready (up to 10 seconds)
        for i in $(seq 1 20); do
            sleep 0.5
            if [ -S "$XDG_DIR/wayland-1" ] || [ -S "$XDG_DIR/wayland-0" ]; then
                break
            fi
        done

        # Restart AGS service for the user
        sudo -u "$HYPR_USER" XDG_RUNTIME_DIR="$XDG_DIR" systemctl --user restart ags.service
    fi
fi
